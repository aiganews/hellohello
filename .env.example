# Local development (no Atlas required):
USE_IN_MEMORY_MONGO=true
PORT=8080
NODE_ENV=development
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
TRUST_PROXY=true
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret
ADMIN_PHONE=+251900642936
SMS_PROVIDER=log
OTP_HASH_SECRET=your-local-otp-hash-secret
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
AWS_REGION=us-east-1
AWS_SECRETS_NAME=hellohello/secrets

# Production / staging:
# USE_IN_MEMORY_MONGO=false
# MONGODB_URI=mongodb+srv://<user>:<url-encoded-password>@cluster0.xxxxx.mongodb.net/hellohello?retryWrites=true&w=majority
# CORS_ORIGINS=https://api.hellohello.app
# SMS_PROVIDER=telnyx
# OTP_HASH_SECRET=<strong-random-value>
# TELNYX_API_KEY=<telnyx-api-key>
# TELNYX_FROM_NUMBER=<telnyx-sms-enabled-e164-number>
# TELNYX_MESSAGING_PROFILE_ID=<optional-telnyx-messaging-profile-id>
# Or use Twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=<twilio-account-sid>
# TWILIO_AUTH_TOKEN=<twilio-auth-token>
# TWILIO_FROM_NUMBER=<twilio-sms-enabled-e164-number>
# TWILIO_MESSAGING_SERVICE_SID=<optional-twilio-messaging-service-sid>
# For WhatsApp template OTP:
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_CONTENT_SID=<twilio-content-template-sid>
# LOG_LEVEL=info
# AWS_REGION=us-east-1
# AWS_SECRETS_NAME=hellohello/secrets
