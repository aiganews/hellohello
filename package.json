{
  "name": "hellohello-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:local:prod": "NODE_ENV=production USE_IN_MEMORY_MONGO=true TRUST_PROXY=true PORT=8080 node src/index.js",
    "dev": "NODE_ENV=development nodemon src/index.js",
    "build": "npm install --production",
    "docker:build": "docker build -t hellohello-api:latest .",
    "docker:local:prod": "docker compose up --build",
    "test": "NODE_ENV=test node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config jest.config.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.359.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^4.18.4",
    "mongodb": "^5.9.2",
    "nvm": "^0.0.4",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "yaml": "^2.3.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  }
}
