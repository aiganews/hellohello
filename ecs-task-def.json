{
  "family": "hellohello-api-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::218549830323:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::218549830323:role/hellohelloTaskRole",
  "containerDefinitions": [
    {
      "name": "hellohello-api",
      "image": "218549830323.dkr.ecr.us-east-1.amazonaws.com/hellohello-api:latest",
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "8080" },
        { "name": "AWS_REGION", "value": "us-east-1" }
      ],
      "secrets": [
        { "name": "MONGODB_URI", "valueFrom": "arn:aws:secretsmanager:us-east-1:218549830323:secret:hellohello/secrets:json:MONGODB_URI::" },
        { "name": "ACCESS_TOKEN_SECRET", "valueFrom": "arn:aws:secretsmanager:us-east-1:218549830323:secret:hellohello/secrets:json:ACCESS_TOKEN_SECRET::" },
        { "name": "REFRESH_TOKEN_SECRET", "valueFrom": "arn:aws:secretsmanager:us-east-1:218549830323:secret:hellohello/secrets:json:REFRESH_TOKEN_SECRET::" },
        { "name": "ADMIN_PHONE", "valueFrom": "arn:aws:secretsmanager:us-east-1:218549830323:secret:hellohello/secrets:json:ADMIN_PHONE::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/hellohello-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
